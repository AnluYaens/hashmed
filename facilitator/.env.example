# Port the facilitator listens on.
PORT=4020

# CAIP-2 network this facilitator settles on.
X402_NETWORK=hedera:testnet

# Fee-payer account that sponsors network fees and submits transactions.
# Must be an ECDSA Hedera account funded with HBAR.
FACILITATOR_ACCOUNT_ID=0.0.xxxxxx
FACILITATOR_PRIVATE_KEY=

# Optional: custom consensus node / mirror endpoint for private Hedera networks.
# HEDERA_NODE_URL=
